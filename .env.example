# Copy to .env and adjust. Variables support GITNEXUS_ prefix (see app/config.py).

GITNEXUS_HOST=0.0.0.0
GITNEXUS_PORT=8000
GITNEXUS_LOG_LEVEL=INFO

GITNEXUS_NEO4J_URI=bolt://localhost:7687
GITNEXUS_NEO4J_USER=neo4j
GITNEXUS_NEO4J_PASSWORD=gitnexus-dev
GITNEXUS_NEO4J_DATABASE=neo4j
GITNEXUS_NEO4J_ENABLED=true

GITNEXUS_DATA_DIR=./data
# Comma-separated absolute roots; empty = no restriction (dev only)
# GITNEXUS_REPO_ROOTS_ALLOWLIST=C:/src,C:/work

GITNEXUS_CYPHER_TIMEOUT_SECONDS=30
GITNEXUS_CYPHER_MAX_ROWS=1000
GITNEXUS_CYPHER_READ_ONLY=true

# Git clone (POST /repos với git_url) — clone vào DATA_DIR/clones/{repo_id}
# GITNEXUS_GIT_URL_ALLOWED_HOSTS=github.com,gitlab.com,*.gitlab.com
# GITNEXUS_GIT_CLONE_DEPTH=1
# GITNEXUS_GIT_CLONE_TIMEOUT_SECONDS=600
